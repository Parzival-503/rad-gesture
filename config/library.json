    {
      "id": "LoginUandP",
      "name": "Log in (username + password)",
      "group": "Logins",
      "sub": "Logins",
      "description": "Types your username, Tab, your password, Enter. Your username is set below; the password is asked once per session and never saved.",
      "hotkey": "+!u",
      "on": true,
      "icon": "login",
      "params": [
        {
          "name": "Tab",
          "type": "bool",
          "label": "Tab between username and password",
          "default": "1"
        },
        {
          "name": "Enter",
          "type": "bool",
          "label": "Enter after the password",
          "default": "1"
        }
      ]
    },
