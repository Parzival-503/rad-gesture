{
  "_about": "RadGesture's function library: Rad Optimizer's functions, built into the helper (LibRun in helper/RadGestureHelper.ahk). Defaults only: what a person changes lives in RadGesture.ini [Lib.<id>]. hotkey = the keyboard shortcut RadGesture listens for; a 'key' param = what the function presses inside Sectra or PowerScribe. 'target' functions just bring that program up and press Key.",
  "version": 1,
  "groups": [
    "PACS (Sectra)",
    "PowerScribe",
    "Logins",
    "Apps"
  ],
  "targets": {
    "sectra": "Sectra (Image Window)",
    "powerscribe": "PowerScribe"
  },
  "functions": [
    {
      "id": "PS_ToggleDictation",
      "name": "Dictation on/off",
      "group": "PowerScribe",
      "sub": "Dictation",
      "description": "Presses the Sectra key first (if Sectra is open), then the dictation key in PowerScribe. Off by default: turn it on if you want it. RadStopwatch also starts its timer on Ctrl+Alt+F4, on purpose.",
      "hotkey": "^!F4",
      "on": false,
      "icon": "mic",
      "params": [
        {
          "name": "Key",
          "type": "key",
          "label": "Presses in PowerScribe",
          "default": "{F4}"
        },
        {
          "name": "SectraKey",
          "type": "key",
          "label": "Presses in Sectra first (empty: skip)",
          "default": "{F8}"
        }
      ]
    },
    {
      "id": "PS_NextField",
      "name": "Next field",
      "group": "PowerScribe",
      "sub": "Navigation",
      "description": "Brings PowerScribe to the front and moves to the next field.",
      "hotkey": "^!f",
      "on": true,
      "icon": "arrow_forward",
      "target": "powerscribe",
      "params": [
        {
          "name": "Key",
          "type": "key",
          "label": "Presses in PowerScribe",
          "default": "{Tab}"
        }
