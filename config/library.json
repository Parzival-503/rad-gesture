{
  "_about": "The built-in functions: defaults only (what a person changes lives in RadGesture.ini [Lib.<id>]). hotkey = the keyboard shortcut RadGesture listens for; a 'key' param = what the function presses inside Sectra or PowerScribe. 'target' functions bring that program up and press Key; others are their own code in the helper (LibRun). 'uses' = the programs a non-target function works in (for the Functions page filters).",
  "version": 1,
  "groups": [
    "PACS (Sectra)",
    "PowerScribe",
    "Logins",
    "Apps"
  ],
  "targets": {
    "sectra": "Sectra (Image Window)",
    "powerscribe": "PowerScribe"
  },
  "functions": [
    {
      "id": "PS_ToggleDictation",
      "name": "Dictate (Sectra, then PowerScribe)",
      "group": "PowerScribe",
      "sub": "Dictation",
      "description": "Two steps in one press. 1) In Sectra it presses the Dictate key (F8): Sectra opens the exam you are viewing in PowerScribe. 2) It brings that PowerScribe window to the front and presses the dictation key (F4), which switches the microphone on (or off). With the Sectra key empty it only toggles dictation in PowerScribe.",
      "hotkey": "^!F4",
      "on": true,
      "icon": "mic",
      "params": [
        {
          "name": "Key",
          "type": "key",
          "label": "Presses in PowerScribe (microphone on/off)",
          "default": "{F4}"
        },
        {
          "name": "SectraKey",
          "type": "key",
          "label": "Presses in Sectra first (Dictate: opens the exam in PowerScribe; empty: skip)",
          "default": "{F8}"
        }
      ],
      "uses": [
        "powerscribe",
        "sectra"
      ]
    },
    {
      "id": "PS_NextField",
      "name": "Next field",
      "group": "PowerScribe",
      "sub": "Navigation",
      "description": "Brings PowerScribe to the front and moves to the next field.",
      "hotkey": "^!f",
      "on": true,
      "icon": "keyboard_tab",
