    {
      "id": "PS_PasteIndication",
      "name": "Paste indication",
      "group": "PowerScribe",
      "sub": "Fields",
      "description": "Copies the text you highlighted, finds the Indication field in PowerScribe and pastes it there. Works only on a selection you make by hand, so it is not on the ring and its shortcut is off by default.",
      "hotkey": "^!g",
      "on": false,
      "icon": "content_paste",
      "params": []
    },
