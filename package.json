{
  "name": "radgesture",
  "productName": "RadGesture",
  "version": "3.0.0",
  "description": "Sina's radiology tool hub: a radial menu (Ctrl+CapsLock) over an AutoHotkey helper that holds the AI tools.",
  "author": "Sina Mazaheri",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check:ahk": "python3 tools/ahk_check.py helper/RadGestureHelper.ahk",
    "preview": "node scripts/preview.js",
    "dist": "electron-builder --win nsis zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "menu.radgesture.hub",
    "productName": "RadGesture",
    "artifactName": "RadGesture-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**", "config/**", "assets/**", "package.json"],
    "extraResources": [{ "from": "helper", "to": "helper", "filter": ["*.ahk"] }],
    "win": { "icon": "assets/icon.ico", "target": ["nsis", "zip"] },
    "nsis": { "artifactName": "RadGesture-Setup-${version}.${ext}", "oneClick": true, "perMachine": false, "runAfterFinish": true, "shortcutName": "RadGesture" }
  }
}
