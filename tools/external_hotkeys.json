  "shared_on_purpose": [
    {
      "key": "^!F4",
      "why": "RadGesture's \"Dictate\" function (off by default: Sectra opens the exam in PowerScribe, then the microphone goes on) and RadStopwatch (~ passes the key through) starts the study timer: one press, both."
    }
  ],
  "sibling_fallback": {
    "_about": "Used only when ../rad-stopwatch/RadStopwatch.ahk is not checked out next to this repo (e.g. on GitHub). The audit compares it with the real file when it is.",
    "script": "RadStopwatch",
    "file": "../rad-stopwatch/RadStopwatch.ahk",
    "hotkeys": [
      {
        "key": "~^!F4",
        "does": "start the study timer"
      },
      {
        "key": "~F4",
        "does": "start the study timer"
      },
      {
        "key": "~F12",
        "does": "stop / sign"
      },
      {
        "key": "WheelUp",
        "does": "par +",
        "context": "mouse over the widget"
      },
      {
        "key": "WheelDown",
        "does": "par -",
        "context": "mouse over the widget"
      },
      {
        "key": "$/",
        "does": "next exam type when the RadStopwatch widget is active; otherwise types / as normal"
      },
      {
        "key": "$.",
        "does": "previous exam type when the RadStopwatch widget is active; otherwise types . as normal"
      }
    ]
  }
